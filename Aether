function openSaveModal(type='in', preselect=''){
  openModal('tplSave',()=>{
    document.getElementById('saveTxType').value=type;
    document.getElementById('saveModalTitle').textContent = type==='in'?'💰 Tambah Tabungan':'💸 Tarik Dana';
    const sel = document.getElementById('saveGoalSelect');
    sel.innerHTML = goals.map(g=>`<option value="${g.id}" ${g.id===preselect?'selected':''}>${g.emoji} ${g.name}</option>`).join('');
  });
}
function setQuickAmount(n){ document.getElementById('saveAmount').value=n; }
function saveTransaction(){
  const goalId = document.getElementById('saveGoalSelect').value;
  const amount = parseFloat(document.getElementById('saveAmount').value);
  const note   = document.getElementById('saveNote').value.trim();
  const type   = document.getElementById('saveTxType').value;
  if(!goalId){ toast('Pilih target dulu ya!','⚠️'); return; }
  if(!amount||amount<=0){ toast('Masukkan nominal yang valid','⚠️'); return; }
  const g = goals.find(x=>x.id===goalId);
  if(!g) return;
  if(type==='out'&&amount>g.current){ toast('Dana tidak mencukupi untuk ditarik','❌'); return; }
  type==='in' ? g.current+=amount : g.current-=amount;
  g.current = Math.max(0,g.current);
  txs.unshift({id:genId(), goalId, goalName:g.name, type, amount, note:note||(type==='in'?'Setoran':'Penarikan'), date:today()});
  if(type==='in') updateStreak();
  checkBadges(); updateChallengeProgress(type==='in'?'save':'withdraw',amount);
  saveAll(); closeModal();
  toast(type==='in'?`+${fmt(amount)} berhasil disimpan! 💰`:`-${fmt(amount)} berhasil ditarik`, type==='in'?'✅':'💸');
  renderAll();
}


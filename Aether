<script>
// ================================================================
//   AUTH — STORAGE SCHEMA
//   tabunganku_accounts : Account[]
//   tabunganku_session  : { userId, loginAt }
//   tabunganku_goals_{userId}
//   tabunganku_txs_{userId}
//   tabunganku_streak_{userId}
//   tabunganku_badges_{userId}
//   tabunganku_challenges_{userId}
// ================================================================

const AK = {
  ACCOUNTS:  'tabunganku_accounts',
  SESSION:   'tabunganku_session',
  goals:     uid => `tabunganku_goals_${uid}`,
  txs:       uid => `tabunganku_txs_${uid}`,
  streak:    uid => `tabunganku_streak_${uid}`,
  badges:    uid => `tabunganku_badges_${uid}`,
  challenges:uid => `tabunganku_challenges_${uid}`,
};

// ----------------------------------------------------------------
//  Simple deterministic hash (for demo; NOT for production use)
// ----------------------------------------------------------------
function simpleHash(str){
  // Pure string-safe hash — no bitwise ops that could produce platform-inconsistent results
  let h1 = 5381, h2 = 52711;
  for(let i = 0; i < str.length; i++){
    const c = str.charCodeAt(i);
    h1 = ((h1 * 33) ^ c) >>> 0;
    h2 = ((h2 * 31) ^ c) >>> 0;
  }
  return h1.toString(16).padStart(8,'0') + h2.toString(16).padStart(8,'0');
}

// ----------------------------------------------------------------
//  Account helpers
// ----------------------------------------------------------------
function getAccounts(){ return JSON.parse(localStorage.getItem(AK.ACCOUNTS)||'[]'); }
function saveAccounts(arr){ localStorage.setItem(AK.ACCOUNTS, JSON.stringify(arr)); }

function getSession(){ return JSON.parse(localStorage.getItem(AK.SESSION)||'null'); }
function saveSession(s){ localStorage.setItem(AK.SESSION, JSON.stringify(s)); }
function clearSession(){ localStorage.removeItem(AK.SESSION); }

function findAccount(username, pw){
  const hash = simpleHash(pw);
  const accounts = getAccounts();
  return accounts.find(a=>
    (a.username && a.username.toLowerCase() === username.toLowerCase()) &&
    (a.passwordHash === hash || a.password === pw)
  ) || null;
}

// ----------------------------------------------------------------
//  Safe Lucide Icons Wrapper
// ----------------------------------------------------------------
function safeCreateIcons(){
  try {
    if (window.lucide && typeof window.lucide.createIcons === 'function') {
      window.lucide.createIcons();
    }
  } catch(e) {
    console.warn('Lucide icon render warning:', e);
  }
}

// ================================================================
//   AUTH FLOW
// ================================================================
let currentUser = null; // active Account object

// ---- Tab switch ----
function switchAuthTab(tab){
  const isLogin = tab === 'login';
  const tabL = document.getElementById('tabLogin');
  const tabR = document.getElementById('tabRegister');
  if(tabL) tabL.className = isLogin ? 'auth-tab-active flex-1 py-4 text-sm transition-all text-center' : 'flex-1 py-4 text-sm text-sage-400 hover:text-sage-600 transition-all text-center border-b-[3px] border-transparent';
  if(tabR) tabR.className = !isLogin ? 'auth-tab-active flex-1 py-4 text-sm transition-all text-center' : 'flex-1 py-4 text-sm text-sage-400 hover:text-sage-600 transition-all text-center border-b-[3px] border-transparent';
  const formL = document.getElementById('formLogin');
  const formR = document.getElementById('formRegister');
  if(formL) formL.classList.toggle('hidden', !isLogin);
  if(formR) formR.classList.toggle('hidden', isLogin);
  safeCreateIcons();
}

// ---- Password visibility toggle ----
function togglePw(inputId, iconId){
  const inp = document.getElementById(inputId);
  const ico = document.getElementById(iconId);
  if(!inp||!ico) return;
  const isHidden = inp.type === 'password';
  inp.type = isHidden ? 'text' : 'password';
  ico.setAttribute('data-lucide', isHidden ? 'eye-off' : 'eye');
  safeCreateIcons();
}

// ---- Field validation helpers ----
function setFieldOk(fieldId, msg=''){
  const el = document.getElementById(fieldId);
  if(!el) return;
  el.classList.remove('field-err'); el.classList.add('field-ok');
  const hint = el.querySelector('.field-hint') || document.getElementById(fieldId.replace('Field','Hint'));
  if(hint){ hint.classList.toggle('hidden', !msg); hint.textContent = msg; }
}
function setFieldErr(fieldId, msg){
  const el = document.getElementById(fieldId);
  if(!el) return;
  el.classList.remove('field-ok'); el.classList.add('field-err');
  const hint = el.querySelector('.field-hint') || document.getElementById(fieldId.replace('Field','Hint'));
  if(hint){ hint.classList.remove('hidden'); hint.textContent = msg; }
}
function clearFieldError(fieldId){
  const el = document.getElementById(fieldId);
  if(!el) return;
  el.classList.remove('field-ok','field-err');
  const hint = el.querySelector('.field-hint') || document.getElementById(fieldId.replace('Field','Hint'));
  if(hint) hint.classList.add('hidden');
}

// ---- Register validation ----
function validateRegName(){
  const el = document.getElementById('regName');
  if(!el) return true;
  const v = el.value.trim();
  if(v.length<2){ setFieldErr('regNameField','Nama minimal 2 karakter'); return false; }
  setFieldOk('regNameField','✓ Nama terlihat bagus!'); return true;
}
function validateRegUsername(){
  const el = document.getElementById('regUsername');
  if(!el) return true;
  const v = el.value.trim();
  if(!/^[a-zA-Z0-9_]{3,20}$/.test(v)){ setFieldErr('regUsernameField','3-20 karakter, huruf/angka/underscore'); return false; }
  const existing = getAccounts().find(a=> a.username && a.username.toLowerCase() === v.toLowerCase());
  if(existing){ setFieldErr('regUsernameField','Username ini sudah dipakai'); return false; }
  setFieldOk('regUsernameField','✓ Username tersedia!'); return true;
}
function validateRegPw(){
  const el = document.getElementById('regPw');
  if(!el) return true;
  const v = el.value;
  const bars = [document.getElementById('sb1'),document.getElementById('sb2'),document.getElementById('sb3'),document.getElementById('sb4')];
  let score = 0;
  if(v.length>=8) score++;
  if(/[A-Z]/.test(v)) score++;
  if(/[0-9]/.test(v)) score++;
  if(/[^A-Za-z0-9]/.test(v)) score++;
  const colors = ['bg-blush-400','bg-amber-400','bg-cream-400','bg-sage-400'];
  bars.forEach((b,i)=>{ if(b) b.className = `flex-1 h-1 rounded-full transition-all duration-300 ${i<score ? colors[Math.min(score-1,3)] : 'bg-sage-100'}`; });
  if(v.length<8){ setFieldErr('regPwField','Minimal 8 karakter'); return false; }
  const labels = ['','Lemah','Sedang','Kuat','Sangat Kuat'];
  setFieldOk('regPwField','Kekuatan: '+labels[score]); return true;
}
function validateRegPw2(){
  const p1 = document.getElementById('regPw');
  const p2 = document.getElementById('regPw2');
  if(!p1||!p2) return true;
  const pw  = p1.value;
  const pw2 = p2.value;
  if(pw!==pw2){ setFieldErr('regPw2Field','Kata sandi tidak cocok'); return false; }
  setFieldOk('regPw2Field','✓ Kata sandi cocok!'); return true;
}

// ---- REGISTER ----
function doRegister(){
  const name     = document.getElementById('regName').value.trim();
  const username = document.getElementById('regUsername').value.trim();
  const pw       = document.getElementById('regPw').value;
  const pw2      = document.getElementById('regPw2').value;
  const termsEl  = document.getElementById('regTerms');
  const terms    = termsEl ? termsEl.checked : true;

  // Run all validations
  const v1 = validateRegName();
  const v2 = validateRegUsername();
  const v3 = validateRegPw();
  const v4 = validateRegPw2();

  if(!v1||!v2||!v3||!v4){ showAuthError('regError','regErrorMsg','Mohon lengkapi formulir pendaftaran dengan benar'); return; }
  if(!terms){ showAuthError('regError','regErrorMsg','Centang persetujuan syarat & ketentuan dulu ya'); return; }

  // Loading state
  setAuthLoading('regBtn','regBtnText','regSpinner', true);

  setTimeout(()=>{
    const accounts = getAccounts();
    if(accounts.find(a=> a.username && a.username.toLowerCase() === username.toLowerCase())){
      setAuthLoading('regBtn','regBtnText','regSpinner', false);
      showAuthError('regError','regErrorMsg','Username ini sudah dipakai oleh akun lain');
      setFieldErr('regUsernameField','Username sudah ada');
      return;
    }

    const newAcc = {
      id: genId(),
      fullName: name,
      username: username,
      email: '@' + username,
      passwordHash: simpleHash(pw),
      createdAt: today()
    };
    accounts.push(newAcc);
    saveAccounts(accounts);

    // Auto-login
    saveSession({ userId: newAcc.id, loginAt: new Date().toISOString() });
    setAuthLoading('regBtn','regBtnText','regSpinner', false);
    toast(`Selamat datang, ${name.split(' ')[0]}! 🎉`,'✅');
    enterApp(newAcc);
  }, 400);
}

// ---- LOGIN ----
function doLogin(){
  const identifier = document.getElementById('loginEmail').value.trim();
  const pw         = document.getElementById('loginPw').value;

  if(!identifier){ setFieldErr('loginEmailField','Masukkan email atau username'); return; }
  if(!pw)         { setFieldErr('loginPwField','Masukkan kata sandi'); return; }

  setAuthLoading('loginBtn','loginBtnText','loginSpinner', true);

  setTimeout(()=>{
    const acc = findAccount(identifier, pw);
    if(!acc){
      setAuthLoading('loginBtn','loginBtnText','loginSpinner', false);
      showAuthError('loginError','loginErrorMsg','Username atau kata sandi salah');
      setFieldErr('loginEmailField','');
      setFieldErr('loginPwField','');
      // Shake animation
      document.getElementById('formLogin').style.animation = 'none';
      setTimeout(()=>{ document.getElementById('formLogin').style.animation = ''; },10);
      return;
    }
    saveSession({ userId: acc.id, loginAt: new Date().toISOString() });
    setAuthLoading('loginBtn','loginBtnText','loginSpinner', false);
    enterApp(acc);
  }, 600);
}

function showAuthError(divId, msgId, msg){
  document.getElementById(divId).classList.remove('hidden');
  document.getElementById(msgId).textContent = msg;
  lucide.createIcons();
}

function setAuthLoading(btnId, textId, spinnerId, loading){
  document.getElementById(btnId).disabled = loading;
  document.getElementById(textId).classList.toggle('hidden', loading);
  document.getElementById(spinnerId).classList.toggle('hidden', !loading);
}

// ---- LOGOUT ----
function doLogout(){
  clearSession();
  currentUser = null;
  goals=[]; txs=[]; streakData={count:0,lastDate:''}; earnedBadges=[]; challenges=[];
  document.getElementById('appShell').classList.add('hidden');
  document.getElementById('authScreen').classList.remove('hidden');
  // Reset login form
  document.getElementById('loginEmail').value = '';
  document.getElementById('loginPw').value = '';
  document.getElementById('loginError').classList.add('hidden');
  ['loginEmailField','loginPwField'].forEach(clearFieldError);
  switchAuthTab('login');
  document.getElementById('profileMenu').classList.add('hidden');
  toast('Berhasil keluar. Sampai jumpa! 👋','👋');
  lucide.createIcons();
}

// ---- ENTER APP ----
function enterApp(acc){
  currentUser = acc;
  loadUserData(acc.id);

  // Update UI profile info
  const initials = acc.fullName.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('sidebarAvatar').textContent  = initials;
  document.getElementById('sidebarName').textContent    = acc.fullName;
  document.getElementById('sidebarEmail').textContent   = acc.email;
  document.getElementById('headerAvatarText').textContent = initials;
  document.getElementById('menuAvatar').textContent     = initials;
  document.getElementById('menuName').textContent       = acc.fullName;
  document.getElementById('menuEmail').textContent      = acc.email;
  document.getElementById('greetingName').textContent   = `Halo, ${acc.fullName.split(' ')[0]}! 👋`;

  // Swap screens
  document.getElementById('authScreen').classList.add('hidden');
  document.getElementById('appShell').classList.remove('hidden');

  // Init app
  initApp();
  lucide.createIcons();
}

// ---- SWITCH ACCOUNT ----
function openAccountsModal(){
  document.getElementById('profileMenu').classList.add('hidden');
  const accounts = getAccounts();
  const list = document.getElementById('accountsList');
  list.innerHTML = accounts.map(a=>{
    const initials = a.fullName.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
    const isCurrent = currentUser && a.id === currentUser.id;
    const clickAttr = !isCurrent ? ('onclick="switchAccount(\'' + a.id + '\')"') : '';
    const activeClass = isCurrent ? 'bg-sage-50 border border-sage-200' : 'hover:bg-sage-50 cursor-pointer';
    const badgeOrArrow = isCurrent ? '<span class="text-[10px] bg-sage-500 text-white px-2 py-0.5 rounded-full font-bold">Aktif</span>' : '<i data-lucide="arrow-right" class="w-4 h-4 text-sage-400 flex-shrink-0"></i>';
    const userHandle = a.email || ('@' + a.username);
    return `
    <div class="flex items-center gap-3 p-3 rounded-2xl ${activeClass} transition-all" ${clickAttr}>
      <div class="w-10 h-10 rounded-full avatar-gradient flex items-center justify-center text-white font-bold text-sm flex-shrink-0">${initials}</div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-sage-800 text-sm truncate">${a.fullName}</p>
        <p class="text-xs text-sage-400 truncate">${userHandle}</p>
      </div>
      ${badgeOrArrow}
    </div>`;
  }).join('');
  document.getElementById('accountsModalOverlay').classList.remove('hidden');
  safeCreateIcons();
}
function closeAccountsModal(e){
  if(e && e.target !== document.getElementById('accountsModalOverlay')) return;
  document.getElementById('accountsModalOverlay').classList.add('hidden');
}
window.closeAccountsModal = function(){ document.getElementById('accountsModalOverlay').classList.add('hidden'); };

function switchAccount(targetId){
  // Switch needs re-auth in a real app. Here we just switch freely for multi-account demo.
  const accounts = getAccounts();
  const acc = accounts.find(a=>a.id===targetId);
  if(!acc) return;
  saveSession({ userId: acc.id, loginAt: new Date().toISOString() });
  closeAccountsModal();
  enterApp(acc);
  toast(`Berpindah ke akun ${acc.fullName.split(' ')[0]} ✓`,'🔄');
}

function toggleProfileMenu(){
  const menu = document.getElementById('profileMenu');
  menu.classList.toggle('hidden');

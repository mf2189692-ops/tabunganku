          <div class="mt-3">
            <div class="flex justify-between text-xs mb-1">
              <span class="text-sage-500 font-medium">${cd.type==='accumulate'?fmt(ch.progress)+' / '+fmt(cd.target):ch.progress+' / '+cd.target+' '+cd.unit}</span>
              <span class="font-bold text-sage-600">${pct}%</span>
            </div>
            <div class="w-full bg-sage-100 rounded-full h-2 overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-sage-400 to-sage-600 progress-bar" style="width:${pct}%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function joinChallenge(id){
  let ch = challenges.find(c=>c.id===id);
  if(!ch){ ch={id,progress:0,started:today(),done:false}; challenges.push(ch); }
  else { ch.started=today(); }
  saveAll(); toast('Tantangan dimulai! Semangat! 💪','🎯'); renderChallenges();
}

function updateChallengeProgress(action, amount=0){
  challenges.forEach(ch=>{
    if(ch.done) return;
    const def = CHALLENGES_DEF.find(d=>d.id===ch.id);
    if(!def||!ch.started) return;
    if(action==='save'){
      if(def.type==='streak') ch.progress=streakData.count;
      if(def.type==='small_daily'&&amount>=def.minAmount&&amount<=def.maxAmount) ch.progress=Math.min(def.target,ch.progress+1);
      if(def.type==='weekly') ch.progress=Math.min(def.target,Math.floor(txs.filter(t=>t.type==='in').length/4));
      if(def.type==='accumulate'&&amount<=def.maxAmount) ch.progress=Math.min(def.target,ch.progress+amount);
    }
    if(ch.progress>=def.target){ ch.done=true; toast(`Tantangan "${def.name}" selesai! 🏆`,'🎉'); }
  });
}

// ================================================================
//   BADGES
// ================================================================
function checkBadges(){
  let newBadge=false;
  BADGES_DEF.forEach(b=>{
    if(!earnedBadges.includes(b.id)&&b.check()){
      earnedBadges.push(b.id); newBadge=true;
      setTimeout(()=>toast(`Lencana baru: ${b.emoji} ${b.name}!`,'🏅'),400);
    }
  });
  if(newBadge) saveAll();
}

// ================================================================
//   CALCULATOR
// ================================================================
function runCalc(){
  const target  = parseFloat(document.getElementById('calcTarget').value)||0;
  const current = parseFloat(document.getElementById('calcCurrent').value)||0;
  const dl      = document.getElementById('calcDeadline').value;
  const res     = document.getElementById('calcResult');
  if(!target||!dl){ res.classList.add('hidden'); return; }
  const daysLeft = Math.ceil((new Date(dl)-new Date())/86400000);
  if(daysLeft<=0){ res.classList.add('hidden'); return; }
  const need     = Math.max(0,target-current);
  res.classList.remove('hidden');
  document.getElementById('calcPerDay').textContent   = fmt(need/daysLeft);
  document.getElementById('calcPerWeek').textContent  = fmt(need/(daysLeft/7));
  document.getElementById('calcPerMonth').textContent = fmt(need/(daysLeft/30));
  document.getElementById('calcDaysLeft').textContent = daysLeft+' hari';
  document.getElementById('calcNote').textContent     = `Sisihkan ${fmt(need/daysLeft)}/hari selama ${daysLeft} hari untuk mencapai ${fmt(target)} pada ${formatDate(dl)}.`;
}
function fillCalcPreset(target,months){
  const dl=new Date(); dl.setMonth(dl.getMonth()+months);
  document.getElementById('calcTarget').value   = target;
  document.getElementById('calcCurrent').value  = '';
  document.getElementById('calcDeadline').value = dl.toISOString().slice(0,10);
  runCalc(); switchPage('calculator');
}

// ================================================================
//   TOAST
// ================================================================
function toast(msg,icon='ℹ️'){
  const tc = document.getElementById('toastContainer');
  const el = document.createElement('div');
  el.className='pointer-events-auto flex items-center gap-3 bg-white shadow-float rounded-2xl px-4 py-3.5 text-sm font-medium text-sage-800 toast-in max-w-xs';
  el.innerHTML=`<span class="text-xl flex-shrink-0">${icon}</span><span>${msg}</span>`;
  tc.appendChild(el);
  setTimeout(()=>{ el.classList.remove('toast-in'); el.classList.add('toast-out'); setTimeout(()=>el.remove(),400); },3000);
}

// ================================================================
//   RENDER ALL
// ================================================================
function renderAll(){
  if(currentPage==='dashboard')    renderDashboard();
  if(currentPage==='goals')        renderGoals();
  if(currentPage==='transactions') renderTransactions();
  if(currentPage==='challenges')   renderChallenges();
  lucide.createIcons();
}

// ================================================================
//   APP INIT (called after login)
// ================================================================
function initApp(){
  currentPage = 'dashboard';
  document.querySelectorAll('section[id^="page-"]').forEach(s=>s.classList.add('hidden'));
  document.getElementById('page-dashboard').classList.remove('hidden');
  document.getElementById('pageTitle').textContent = 'Ringkasan';
  // Reset nav
  document.querySelectorAll('.nav-item').forEach(btn=>{
    const isActive = btn.dataset.page==='dashboard';
    btn.classList.toggle('active',isActive);
  });
  // Date
  const now = new Date();
  document.getElementById('pageDate').textContent = now.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  // Tip
  document.getElementById('tipText').textContent = TIPS[Math.floor(Math.random()*TIPS.length)];
  // Render
  renderDashboard();
  safeCreateIcons();
}

function addMonths(n){
  const d=new Date(); d.setMonth(d.getMonth()+n);
  return d.toISOString().slice(0,10);
}

// ================================================================
//   SPLASH SCREEN CONTROLLER (Made by Ather Company)
// ================================================================
let splashDismissed = false;
function dismissSplash(){
  if (splashDismissed) return;
  splashDismissed = true;
  const splash = document.getElementById('splashScreen');
  if (!splash) return;
  splash.classList.add('fade-out');
  setTimeout(() => {
    try {
      splash.style.display = 'none';
      splash.style.visibility = 'hidden';
      if (splash.parentNode) {
        splash.parentNode.removeChild(splash);
      }
    } catch(e){}
  }, 650);
}

// Auto dismiss intro splash screen after 2.4s
setTimeout(dismissSplash, 2400);

// Clean any legacy demo data from testing
(function cleanLegacyDemo(){
  try {
    const accounts = getAccounts();
    const filtered = accounts.filter(a => a.id !== 'acc_demo_budi' && a.username !== 'budi');
    if (filtered.length !== accounts.length) {
      saveAccounts(filtered);
      localStorage.removeItem(AK.goals('acc_demo_budi'));
      localStorage.removeItem(AK.txs('acc_demo_budi'));
      localStorage.removeItem(AK.streak('acc_demo_budi'));
      localStorage.removeItem(AK.badges('acc_demo_budi'));
      const sess = getSession();
      if (sess && sess.userId === 'acc_demo_budi') clearSession();
    }
  } catch(e){}
})();

function attachAuthListeners(){
  const tLog = document.getElementById('tabLogin');
  const tReg = document.getElementById('tabRegister');
  const bLog = document.getElementById('loginBtn');
  const bReg = document.getElementById('regBtn');

  if(tLog) tLog.onclick = () => switchAuthTab('login');
  if(tReg) tReg.onclick = () => switchAuthTab('register');
  if(bLog) bLog.onclick = () => doLogin();
  if(bReg) bReg.onclick = () => doRegister();
}

(function boot(){
  attachAuthListeners();
  safeCreateIcons();

  const session = getSession();
  if(session && session.userId){
    const accounts = getAccounts();
    const acc = accounts.find(a=>a.id===session.userId);
    if(acc){ enterApp(acc); return; }
  }
  // No valid session — show auth screen
  document.getElementById('authScreen').classList.remove('hidden');
  document.getElementById('appShell').classList.add('hidden');
  safeCreateIcons();
})();
</script>

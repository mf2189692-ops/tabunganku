<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TabunganKu — Ceritakan Impianmu</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='14' fill='%2307120a'/%3E%3Crect x='6' y='6' width='36' height='36' rx='10' stroke='%2334d399' stroke-width='2.5' fill='%23132a1c'/%3E%3Ccircle cx='24' cy='24' r='11' stroke='%23fde68a' stroke-width='2' stroke-dasharray='2 3' fill='none'/%3E%3Cpath d='M18 27l4-5 3 3 5-6' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M26 19h4v4' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='32' cy='16' r='1.5' fill='%23fde68a'/%3E%3C/svg%3E" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            sage:  { 50:'#f2f7f2', 100:'#e0ece0', 200:'#c2d9c2', 300:'#97be97', 400:'#6a9e6a', 500:'#4a7c4a', 600:'#3b6b3b', 700:'#2f562f', 800:'#274627', 900:'#213921' },
            mint:  { 50:'#f0fdf4', 100:'#dcfce7', 200:'#bbf7d0', 300:'#86efac', 400:'#4ade80', 500:'#22c55e' },
            cream: { 50:'#fffdf7', 100:'#fef9ec', 200:'#fdf0c8', 300:'#fbe5a0', 400:'#f7d060', 500:'#f0bb2a' },
            blush: { 50:'#fff5f5', 100:'#ffe4e4', 200:'#ffc9c9', 300:'#ffa0a0', 400:'#ff6b6b', 500:'#f03e3e' },
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          borderRadius: { '4xl':'2rem', '5xl':'2.5rem' },
          boxShadow: {
            'soft':  '0 2px 20px rgba(0,0,0,0.06)',
            'card':  '0 4px 32px rgba(74,124,74,0.10)',
            'float': '0 8px 40px rgba(0,0,0,0.12)',
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;}
    body{font-family:'Inter',system-ui,sans-serif;background:#f6faf6;}

    /* ---- Scrollbar ---- */
    ::-webkit-scrollbar{width:6px;}
    ::-webkit-scrollbar-track{background:#f0fdf4;}
    ::-webkit-scrollbar-thumb{background:#97be97;border-radius:9999px;}

    /* ---- Nav Active ---- */
    .nav-item.active{background:#e0ece0;color:#3b6b3b;}
    .nav-item.active svg{color:#4a7c4a;}

    /* ---- Progress Bar ---- */
    .progress-bar{transition:width 0.8s cubic-bezier(.4,0,.2,1);}

    /* ---- Streak Flame ---- */
    @keyframes flicker{0%,100%{transform:scaleY(1) rotate(-2deg)}50%{transform:scaleY(1.08) rotate(2deg)}}
    .flame{animation:flicker .9s ease-in-out infinite;display:inline-block;transform-origin:bottom center;}

    /* ---- Badge Shine ---- */
    @keyframes shine{0%{background-position:-200%}100%{background-position:200%}}
    .badge-earned{background:linear-gradient(90deg,#f7d060,#fbe5a0,#f7d060);background-size:200%;animation:shine 2s linear infinite;}

    /* ---- Card Hover ---- */
    .goal-card{transition:transform .2s,box-shadow .2s;}
    .goal-card:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(74,124,74,.18);}

    /* ---- Input focus ---- */
    input:focus,select:focus,textarea:focus{outline:none;box-shadow:0 0 0 3px rgba(74,124,74,.2);}

    /* ---- Toast ---- */
    @keyframes toastIn {from{transform:translateX(120%);opacity:0}to{transform:translateX(0);opacity:1}}
    @keyframes toastOut{from{transform:translateX(0);opacity:1}to{transform:translateX(120%);opacity:0}}
    .toast-in {animation:toastIn  .4s cubic-bezier(.4,0,.2,1) forwards;}
    .toast-out{animation:toastOut .4s cubic-bezier(.4,0,.2,1) forwards;}

    /* ---- Modal / Auth overlays ---- */
    @keyframes slideUp{from{transform:translateY(40px);opacity:0}to{transform:translateY(0);opacity:1}}
    .slide-up{animation:slideUp .35s cubic-bezier(.4,0,.2,1) forwards;}
    @keyframes fadeIn{from{opacity:0}to{opacity:1}}
    .fade-in{animation:fadeIn .4s ease forwards;}

    /* ---- Auth page ---- */
    @keyframes blobFloat{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-18px) scale(1.04)}}
    .blob{animation:blobFloat 6s ease-in-out infinite;}
    .blob2{animation:blobFloat 8s ease-in-out 1s infinite;}

    /* ---- Auth tab indicator ---- */
    .auth-tab-active{border-bottom:3px solid #4a7c4a;color:#3b6b3b;font-weight:700;}

    /* ---- Validation states ---- */
    .field-ok input,.field-ok select{border-color:#6a9e6a !important;background:#f2f7f2 !important;}
    .field-err input,.field-err select{border-color:#ff6b6b !important;background:#fff5f5 !important;box-shadow:0 0 0 3px rgba(255,107,107,.15) !important;}
    .field-hint{font-size:11px;margin-top:4px;padding-left:2px;}
    .field-ok .field-hint{color:#4a7c4a;}
    .field-err .field-hint{color:#f03e3e;}

    /* ---- Password strength ---- */
    .strength-bar{height:4px;border-radius:9999px;transition:width .4s,background .4s;}

    /* ---- Avatar gradient ---- */
    .avatar-gradient{background:linear-gradient(135deg,#4a7c4a,#22c55e);}

    /* ---- Profile dropdown ---- */
    @keyframes dropIn{from{transform:translateY(-8px);opacity:0}to{transform:translateY(0);opacity:1}}
    .drop-in{animation:dropIn .2s cubic-bezier(.4,0,.2,1) forwards;}

    /* ---- Shimmer loading ---- */
    @keyframes shimmer{0%{background-position:-400px 0}100%{background-position:400px 0}}
    .shimmer{background:linear-gradient(90deg,#e0ece0 25%,#f2f7f2 50%,#e0ece0 75%);background-size:400px 100%;animation:shimmer 1.2s ease infinite;}

    /* ---- Splash Screen System (Solid 100% Opaque, Zero Transparency) ---- */
    #splashScreen{
      position:fixed !important;
      inset:0 !important;
      top:0 !important;
      left:0 !important;
      width:100vw !important;
      height:100vh !important;
      z-index:999999 !important;
      background-color:#07120a !important;
      background-image:radial-gradient(circle at 50% 35%, #14301f 0%, #09170e 55%, #040906 100%) !important;
      background-repeat:no-repeat !important;
      background-size:cover !important;
      display:flex !important;
      flex-direction:column !important;
      align-items:center !important;
      justify-content:center !important;
      opacity:1;
      transition:opacity .6s cubic-bezier(.4,0,.2,1),transform .6s cubic-bezier(.4,0,.2,1);
      overflow:hidden !important;
    }
    #splashScreen.fade-out{
      opacity:0 !important;
      transform:scale(1.06) !important;
      pointer-events:none !important;
    }
    @keyframes splashPop{
      0%{opacity:0;transform:scale(.82) translateY(28px)}
      60%{opacity:1;transform:scale(1.03) translateY(-4px)}
      100%{opacity:1;transform:scale(1) translateY(0)}
    }
    .splash-card{animation:splashPop .9s cubic-bezier(.16,1,.3,1) forwards;}
    @keyframes pulseAura{
      0%,100%{transform:scale(.9);opacity:.35}
      50%{transform:scale(1.35);opacity:.75}
    }
    .splash-pulse-aura{animation:pulseAura 3s ease-in-out infinite;}
    @keyframes pulseRing{
      0%,100%{transform:scale(1);opacity:.5}
      50%{transform:scale(1.1);opacity:.9}
    }
    .splash-pulse-ring{animation:pulseRing 2.4s ease-in-out infinite;}
    @keyframes progressAnim{
      0%{width:0%}
      100%{width:100%}
    }
    .splash-progress-bar{animation:progressAnim 2.2s cubic-bezier(.4,0,.2,1) forwards;}
    @keyframes shimmerGold{
      0%{transform:translateX(-150%)}
      100%{transform:translateX(200%)}
    }
    .shimmer-badge{position:relative;overflow:hidden;}
    .shimmer-badge::after{
      content:'';position:absolute;inset:0;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.25),transparent);
      transform:translateX(-150%);
      animation:shimmerGold 2.2s infinite ease-in-out .4s;
    }
  </style>
</head>
<body class="min-h-screen bg-sage-50">

<!-- ================================================================
     SPLASH SCREEN / INTRO ANIMATION (Made by Ather Company)
================================================================ -->
<div id="splashScreen" class="select-none cursor-pointer" style="background-color:#07120a; background-image:radial-gradient(circle at 50% 35%, #14301f 0%, #09170e 55%, #040906 100%);" onclick="dismissSplash()">
  <!-- Ambient background glow elements -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-amber-400/10 blur-3xl pointer-events-none" style="animation-delay: 1.5s;"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full bg-emerald-400/10 blur-2xl pointer-events-none"></div>

  <!-- Central Card -->
  <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-sm splash-card">
    
    <!-- Modern Financial Vault & Growth Aura Logo -->
    <div class="relative mb-6">
      <!-- Pulsing Aura 1 -->
      <div class="absolute -inset-4 rounded-full bg-emerald-500/25 blur-2xl splash-pulse-aura"></div>
      <!-- Pulsing Aura 2 (Gold ring) -->
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-mint-400/30 to-amber-300/30 blur-md splash-pulse-ring"></div>
      <!-- Glass Vault Container -->
      <div class="relative w-24 h-24 rounded-3xl bg-slate-900/90 backdrop-blur-2xl border border-emerald-400/40 shadow-2xl flex items-center justify-center p-4 shimmer-badge">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full filter drop-shadow">
          <defs>
            <linearGradient id="splashVaultGrad" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#34d399"/>
              <stop offset="50%" stop-color="#10b981"/>
              <stop offset="100%" stop-color="#059669"/>
            </linearGradient>
            <linearGradient id="splashGoldGrad" x1="12" y1="10" x2="36" y2="38" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fde68a"/>
              <stop offset="50%" stop-color="#f59e0b"/>
              <stop offset="100%" stop-color="#d97706"/>
            </linearGradient>
          </defs>
          <!-- Vault Outer Frame -->
          <rect x="5" y="5" width="38" height="38" rx="14" fill="url(#splashVaultGrad)" fill-opacity="0.25" stroke="url(#splashVaultGrad)" stroke-width="2.5"/>
          <!-- Inner Dial / Coin Ring -->
          <circle cx="24" cy="24" r="13" stroke="url(#splashGoldGrad)" stroke-width="2" stroke-dasharray="3 3"/>
          <circle cx="24" cy="24" r="8" fill="url(#splashVaultGrad)" fill-opacity="0.4"/>
          <!-- Upward Financial Growth Trendline -->
          <path d="M18 27L22 22L25 25L30 19" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M26 19H30V23" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Sparkle star -->
          <circle cx="32" cy="16" r="1.5" fill="#fde68a"/>
        </svg>
      </div>
    </div>

    <!-- App Title & Tagline -->
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2 filter drop-shadow">
      TabunganKu
    </h1>
    <p class="text-sm font-medium text-emerald-200/90 mb-6 tracking-wide">
      Ceritakan Impianmu, Wujudkan Nyatamu
    </p>

    <!-- Branding: Made by Ather Company -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-950/70 border border-emerald-400/30 backdrop-blur-xl shadow-lg mb-8 shimmer-badge">
      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-ping"></span>
      <span class="text-xs tracking-widest text-emerald-100 uppercase font-semibold">
        Made by <span class="text-white font-extrabold tracking-widest">Ather Company</span>
      </span>
    </div>

    <!-- Modern Loading Bar & Indicator -->
    <div class="w-44 h-1.5 bg-white/10 rounded-full overflow-hidden mb-3 border border-white/5 relative">
      <div class="h-full bg-gradient-to-r from-emerald-400 via-mint-300 to-amber-300 rounded-full splash-progress-bar shadow-[0_0_10px_rgba(52,211,153,0.8)]"></div>
    </div>
    <div class="flex items-center gap-2 text-[11px] text-emerald-300/70 font-mono tracking-wider">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span>Memuat sistem keamanan & tabungan...</span>
    </div>
  </div>

  <span class="absolute bottom-6 text-[10px] text-emerald-400/40 tracking-wider">Ketuk layar untuk langsung masuk</span>
</div>

<!-- ================================================================
     TOAST CONTAINER
================================================================ -->
<div id="toastContainer" class="fixed top-5 right-5 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

<!-- ================================================================
     AUTH SCREEN  (shown when not logged in)
================================================================ -->
<div id="authScreen" class="fixed inset-0 z-[80] flex items-center justify-center overflow-y-auto">

  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-sage-700 via-sage-600 to-sage-800 overflow-hidden">
    <div class="blob absolute -top-24 -left-24 w-96 h-96 rounded-full bg-mint-400/20 blur-3xl"></div>
    <div class="blob2 absolute -bottom-32 -right-16 w-80 h-80 rounded-full bg-cream-300/20 blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-40 h-40 rounded-full bg-sage-400/10 blur-2xl"></div>
    <!-- Decorative dots -->
    <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs><pattern id="dots" x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill="white"/></pattern></defs>
      <rect width="100%" height="100%" fill="url(#dots)"/>
    </svg>
  </div>

  <!-- Auth Card -->
  <div class="relative z-10 w-full max-w-sm mx-4 my-8">

    <!-- Logo + brand -->
    <div class="text-center mb-8 fade-in">
      <div class="inline-flex w-20 h-20 rounded-3xl bg-white/15 backdrop-blur-xl border border-white/25 items-center justify-center mb-4 shadow-float p-3.5">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full filter drop-shadow">
          <defs>
            <linearGradient id="authVaultGrad" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#34d399"/>
              <stop offset="50%" stop-color="#10b981"/>
              <stop offset="100%" stop-color="#059669"/>
            </linearGradient>
            <linearGradient id="authGoldGrad" x1="12" y1="10" x2="36" y2="38" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fde68a"/>
              <stop offset="50%" stop-color="#f59e0b"/>
              <stop offset="100%" stop-color="#d97706"/>
            </linearGradient>
          </defs>
          <rect x="5" y="5" width="38" height="38" rx="14" fill="url(#authVaultGrad)" fill-opacity="0.25" stroke="url(#authVaultGrad)" stroke-width="2.5"/>
          <circle cx="24" cy="24" r="13" stroke="url(#authGoldGrad)" stroke-width="2" stroke-dasharray="3 3"/>
          <circle cx="24" cy="24" r="8" fill="url(#authVaultGrad)" fill-opacity="0.35"/>
          <path d="M18 27L22 22L25 25L30 19" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M26 19H30V23" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="32" cy="16" r="1.5" fill="#fde68a"/>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">TabunganKu</h1>
      <p class="text-sage-200 text-sm mt-1">Ceritakan impianmu, mulai dari sini</p>
    </div>

    <!-- Auth panel -->
    <div class="bg-white rounded-4xl shadow-float overflow-hidden slide-up">

      <!-- Tabs -->
      <div class="flex border-b border-sage-100">
        <button type="button" id="tabLogin" onclick="switchAuthTab('login')"
          class="auth-tab-active flex-1 py-4 text-sm transition-all text-center">
          Masuk
        </button>
        <button type="button" id="tabRegister" onclick="switchAuthTab('register')"
          class="flex-1 py-4 text-sm text-sage-400 hover:text-sage-600 transition-all text-center border-b-[3px] border-transparent">
          Daftar
        </button>
      </div>

      <!-- Login Form -->
      <div id="formLogin" class="p-6 space-y-4">
        <p class="text-xs text-sage-400 text-center">Selamat datang kembali! 👋</p>

        <!-- Username -->
        <div id="loginEmailField" class="field-group">
          <label class="text-xs font-semibold text-sage-600 block mb-1.5">Username</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sage-400">
              <i data-lucide="at-sign" class="w-4 h-4"></i>
            </span>
            <input id="loginEmail" type="text" placeholder="Masukkan username kamu"
              oninput="clearFieldError('loginEmailField')"
              onkeydown="if(event.key==='Enter')doLogin()"
              class="w-full border border-sage-200 rounded-2xl pl-10 pr-4 py-3 text-sm bg-sage-50 focus:bg-white transition-all" />
          </div>
          <p class="field-hint hidden" id="loginEmailHint"></p>
        </div>

        <!-- Password -->
        <div id="loginPwField" class="field-group">
          <label class="text-xs font-semibold text-sage-600 block mb-1.5">Kata Sandi</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sage-400">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </span>
            <input id="loginPw" type="password" placeholder="Masukkan kata sandi"
              oninput="clearFieldError('loginPwField')"
              onkeydown="if(event.key==='Enter')doLogin()"
              class="w-full border border-sage-200 rounded-2xl pl-10 pr-11 py-3 text-sm bg-sage-50 focus:bg-white transition-all" />
            <button type="button" onclick="togglePw('loginPw', 'eyeLogin')"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sage-400 hover:text-sage-600">
              <i id="eyeLogin" data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
          <p class="field-hint hidden" id="loginPwHint"></p>
        </div>

        <!-- Global error -->
        <div id="loginError" class="hidden bg-blush-50 border border-blush-200 rounded-2xl px-4 py-3 flex items-center gap-2">
          <i data-lucide="alert-circle" class="w-4 h-4 text-blush-500 flex-shrink-0"></i>
          <p id="loginErrorMsg" class="text-xs text-blush-600 font-medium"></p>
        </div>

        <button type="button" onclick="doLogin()" id="loginBtn"
          class="w-full bg-sage-500 text-white py-3.5 rounded-2xl font-bold text-sm hover:bg-sage-600 active:scale-[.98] transition-all shadow-card flex items-center justify-center gap-2">
          <span id="loginBtnText">Masuk Sekarang</span>
          <div id="loginSpinner" class="hidden w-4 h-4 border-2 border-white/40 border-t-white rounded-full animate-spin"></div>
        </button>

        <p class="text-center text-xs text-sage-400">
          Belum punya akun?
          <button type="button" onclick="switchAuthTab('register')" class="text-sage-600 font-semibold hover:underline">Daftar sekarang</button>
        </p>
      </div>

      <!-- Register Form -->
      <div id="formRegister" class="hidden p-6 space-y-4">
        <p class="text-xs text-sage-400 text-center">Mulai perjalanan menabungmu! 🌱</p>

        <!-- Full Name -->
        <div id="regNameField" class="field-group">
          <label class="text-xs font-semibold text-sage-600 block mb-1.5">Nama Lengkap</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sage-400">
              <i data-lucide="user" class="w-4 h-4"></i>
            </span>
            <input id="regName" type="text" placeholder="Nama Lengkap Kamu"
              oninput="validateRegName()"
              class="w-full border border-sage-200 rounded-2xl pl-10 pr-4 py-3 text-sm bg-sage-50 focus:bg-white transition-all" />
          </div>
          <p class="field-hint hidden" id="regNameHint"></p>
        </div>

        <!-- Username -->
        <div id="regUsernameField" class="field-group">
          <label class="text-xs font-semibold text-sage-600 block mb-1.5">Username</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sage-400">
              <i data-lucide="at-sign" class="w-4 h-4"></i>
            </span>
            <input id="regUsername" type="text" placeholder="username_kamu (3-20 karakter)"
              oninput="validateRegUsername()"
              class="w-full border border-sage-200 rounded-2xl pl-10 pr-4 py-3 text-sm bg-sage-50 focus:bg-white transition-all" />
          </div>
          <p class="field-hint hidden" id="regUsernameHint"></p>
        </div>

        <!-- Password -->
        <div id="regPwField" class="field-group">
          <label class="text-xs font-semibold text-sage-600 block mb-1.5">Kata Sandi</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sage-400">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </span>
            <input id="regPw" type="password" placeholder="Min. 8 karakter"
              oninput="validateRegPw()"
              class="w-full border border-sage-200 rounded-2xl pl-10 pr-11 py-3 text-sm bg-sage-50 focus:bg-white transition-all" />
            <button type="button" onclick="togglePw('regPw','eyeReg')"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sage-400 hover:text-sage-600">
              <i id="eyeReg" data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
          <!-- Strength bar -->
          <div class="flex gap-1 mt-2">
            <div id="sb1" class="flex-1 h-1 rounded-full bg-sage-100 transition-all duration-300"></div>
            <div id="sb2" class="flex-1 h-1 rounded-full bg-sage-100 transition-all duration-300"></div>

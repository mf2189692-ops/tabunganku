function openGoalDetail(id){
  const g = goals.find(x=>x.id===id); if(!g) return;
  const c   = getColor(g.color);
  const pct = Math.min(100,Math.round(g.current/g.target*100));
  openModal('tplGoalDetail',()=>{
    document.getElementById('detailEmoji').textContent   = g.emoji;
    document.getElementById('detailName').textContent    = g.name;
    document.getElementById('detailDeadline').textContent= `Tenggat: ${formatDate(g.deadline)}`;
    document.getElementById('detailCurrent').textContent = fmt(g.current);
    document.getElementById('detailGoal').textContent    = fmt(g.target);
    document.getElementById('detailPct').textContent     = pct+'%';
    const bar = document.getElementById('detailProgress');
    bar.className = `h-full rounded-full bg-gradient-to-r ${c.grad} progress-bar`;
    setTimeout(()=>{ bar.style.width=pct+'%'; },50);
    const gtxs = txs.filter(t=>t.goalId===id).slice(0,10);
    const dtl  = document.getElementById('detailTxList');
    dtl.innerHTML = gtxs.length===0 ? '<p class="text-xs text-sage-400 text-center py-3">Belum ada transaksi</p>' : gtxs.map(t=>txItemHTML(t)).join('');
    document.getElementById('detailAddBtn').onclick = ()=>{ closeModal(); setTimeout(()=>openSaveModal('in',id),100); };
    document.getElementById('detailWithdrawBtn').onclick = ()=>{ closeModal(); setTimeout(()=>openSaveModal('out',id),100); };
    document.getElementById('detailDeleteBtn').onclick = ()=>deleteGoal(id);
  });
}
function deleteGoal(id){
  if(!confirm('Hapus target ini? Semua riwayat transaksinya juga akan dihapus.')) return;
  goals=goals.filter(g=>g.id!==id); txs=txs.filter(t=>t.goalId!==id);
  saveAll(); closeModal(); toast('Target berhasil dihapus','🗑️'); renderAll();
}


function updateStreak(){
  const td = today();
  if(streakData.lastDate===td) return;
  const yesterday = new Date(); yesterday.setDate(yesterday.getDate()-1);
  const yStr = yesterday.toISOString().slice(0,10);
  streakData.count = (streakData.lastDate===yStr) ? streakData.count+1 : 1;
  streakData.lastDate = td;
}


function openAddGoalModal(){
  openModal('tplAddGoal',()=>{
    const ep = document.getElementById('emojiPicker');
    ep.innerHTML = EMOJIS.map((em,i)=>`<button type="button" onclick="selectEmoji(this,'${em}')" class="emoji-btn text-2xl p-2 rounded-xl hover:bg-sage-100 transition-all ${i===0?'bg-sage-100 ring-2 ring-sage-300':''}">${em}</button>`).join('');
    const cp = document.getElementById('colorPicker');
    cp.innerHTML = COLORS.map((c,i)=>`<button type="button" onclick="selectColor(this,'${c.name}')" class="color-btn w-8 h-8 rounded-full ${c.bg} transition-all ${i===0?'ring-4 ring-offset-2 '+c.ring:''}"></button>`).join('');
    document.getElementById('newGoalDeadline').min = today();
  });
}
function selectEmoji(btn,em){
  document.querySelectorAll('.emoji-btn').forEach(b=>b.classList.remove('bg-sage-100','ring-2','ring-sage-300'));
  btn.classList.add('bg-sage-100','ring-2','ring-sage-300');
  document.getElementById('newGoalEmoji').value=em;
}
function selectColor(btn,name){
  document.querySelectorAll('.color-btn').forEach(b=>b.className=b.className.replace(/ring-4 ring-offset-2 ring-\S+/g,''));
  const c=getColor(name);
  btn.classList.add('ring-4','ring-offset-2',c.ring);
  document.getElementById('newGoalColor').value=name;
}
function addGoal(){
  const name   = document.getElementById('newGoalName').value.trim();
  const target = parseFloat(document.getElementById('newGoalTarget').value);
  const init   = parseFloat(document.getElementById('newGoalInitial').value)||0;
  const dl     = document.getElementById('newGoalDeadline').value;
  const emoji  = document.getElementById('newGoalEmoji').value;
  const color  = document.getElementById('newGoalColor').value;
  if(!name){ toast('Masukkan nama impian dulu ya!','⚠️'); return; }
  if(!target||target<=0){ toast('Target nominal harus lebih dari 0','⚠️'); return; }
  if(!dl){ toast('Tentukan tenggat waktunya ya!','⚠️'); return; }
  const g = {id:genId(), name, target, current:init, deadline:dl, emoji, color, createdAt:today()};
  goals.push(g);
  if(init>0) txs.unshift({id:genId(), goalId:g.id, goalName:g.name, type:'in', amount:init, note:'Dana awal', date:today()});
  updateStreak(); checkBadges(); updateChallengeProgress('save');
  saveAll(); closeModal(); toast(`Target "${name}" berhasil dibuat! 🎉`,'✅'); renderAll();
}

